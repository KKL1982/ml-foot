@model FootballPrediction.Web.Models.BatchResultViewModel
@{
    ViewData["Title"] = "Batch Results";
    int countHome = Model.Predictions.Count(p => p.PredictedResult == "HOME");
    int countAway = Model.Predictions.Count(p => p.PredictedResult == "AWAY");
    int countSkip = Model.Predictions.Count(p => p.PredictedResult == "SKIP");
    int countX = Model.Predictions.Count(p => p.PredictedResult == "X");
    int count1 = Model.Predictions.Count(p => p.PredictedResult == "1");
    int count2 = Model.Predictions.Count(p => p.PredictedResult == "2");
    bool isBinary = Model.Predictions.Any(p => p.Mode == "Binary");
}

<div class="page-title">Batch Prediction Results</div>

@foreach (var warning in Model.Warnings)
{
    <div class="card" style="border-left:3px solid var(--amber,#f5a524);margin-bottom:12px;font-size:13px">&#9888;&#65039; @warning</div>
}
@if (!string.IsNullOrEmpty(Model.SourceFileName))
{
    <div style="color:var(--tx2);font-size:12px;margin-bottom:12px">
        Matchs lus depuis <strong>@Model.SourceFileName</strong> —
        <a href="/Batch/DownloadFile?fileName=@Uri.EscapeDataString(Model.SourceFileName)">télécharger ce CSV</a>
    </div>
}

<div class="kpi-grid">
    <div class="kpi-card kpi-blue">
        <div class="kpi-header">📁 Matches Processed</div>
        <div class="kpi-value">@Model.TotalMatches</div>
        <div class="kpi-sub">From uploaded CSV</div>
    </div>
    <div class="kpi-card kpi-green">
        <div class="kpi-header">✅ Predictions</div>
        <div class="kpi-value">@Model.SuccessfulPredictions</div>
        <div class="kpi-sub">Successfully predicted</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-header">📊 Distribution</div>
        <div class="kpi-value" style="font-size:18px">
            @if (isBinary)
            {
                <span style="color:var(--green)">@countHome</span>
                <text> / </text>
                <span style="color:var(--blue)">@countAway</span>
                <text> / </text>
                <span style="color:var(--yellow)">@countSkip</span>
            }
            else
            {
                <span style="color:var(--green)">@count1</span>
                <text> / </text>
                <span style="color:var(--yellow)">@countX</span>
                <text> / </text>
                <span style="color:var(--blue)">@count2</span>
            }
        </div>
        <div class="kpi-sub">@(isBinary ? "HOME — AWAY — SKIP" : "1 — X — 2")</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-header">📈 Avg Confidence</div>
        <div class="kpi-value" style="font-size:18px">
            @(Model.Predictions.Any() ? Model.Predictions.Average(p => p.Confidence).ToString("P0") : "—")
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header" style="justify-content:space-between">
        <span>Predictions Table</span>
        <div style="display:flex;gap:8px">
            @if (Model.HasDownload)
            {
                <a href="/batch/download" class="btn btn-green btn-sm">📥 Download CSV</a>
            }
            <a href="/batch" class="btn btn-outline btn-sm">New Upload</a>
        </div>
    </div>
    <div class="sort-bar" id="sortBar" hidden>
        <label for="sortSelect">Trier par</label>
        <select id="sortSelect" class="form-select"></select>
        <button type="button" id="sortDir" class="btn btn-outline btn-sm" aria-label="Inverser l'ordre">↑ Croissant</button>
        <button type="button" id="sortReset" class="btn btn-outline btn-sm">Ordre initial</button>
    </div>
    <div class="table-wrap">
        <table class="table" id="resultTable">
            <thead>
                <tr>
                    <th data-key="date" data-label="Date">Date</th>
                    <th data-key="league" data-label="Championnat">League</th>
                    <th data-key="home" data-label="Domicile">Home</th>
                    <th data-key="away" data-label="Extérieur">Away</th>
                    <th data-key="hcoach" data-label="Coach domicile">HomeCoach</th>
                    <th data-key="acoach" data-label="Coach extérieur">AwayCoach</th>
                    <th data-key="bet" data-label="Pari">Bet</th>
                    @if (isBinary)
                    {
                        <th data-key="p1" data-type="num" data-label="Proba domicile">HomeProb</th>
                        <th data-key="conf" data-type="num" data-label="Confiance">Conf</th>
                    }
                    else
                    {
                        <th data-key="p1" data-type="num" data-label="Proba 1">1</th>
                        <th data-key="px" data-type="num" data-label="Proba X">X</th>
                        <th data-key="p2" data-type="num" data-label="Proba 2">2</th>
                        <th data-key="conf" data-type="num" data-label="Confiance">Conf</th>
                    }
                    <th data-key="comment" data-label="Commentaire">Comment</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Predictions)
                {
                    string badgeClass = isBinary
                        ? (p.PredictedResult == "HOME" ? "badge-1" : p.PredictedResult == "AWAY" ? "badge-2" : "badge-X")
                        : (p.PredictedResult switch { "1" => "badge-1", "X" => "badge-X", "2" => "badge-2", _ => "" });
                    string confClass = p.Confidence >= 0.6 ? "conf-high" : p.Confidence >= 0.45 ? "conf-med" : "conf-low";
                    <tr>
                        <td data-v="@p.Date.ToString("yyyy-MM-dd")">@p.Date.ToString("yyyy-MM-dd")</td>
                        <td>@p.League</td>
                        <td>@p.HomeTeam</td>
                        <td>@p.AwayTeam</td>
                        <td>@(p.HomeCoach ?? "—")</td>
                        <td>@(p.AwayCoach ?? "—")</td>
                        <td><span class="badge @badgeClass">@p.PredictedResult</span></td>
                        @if (isBinary)
                        {
                            <td data-v="@p.HomeWinProbability.ToString(System.Globalization.CultureInfo.InvariantCulture)">@p.HomeWinProbability.ToString("P0")</td>
                            <td data-v="@p.Confidence.ToString(System.Globalization.CultureInfo.InvariantCulture)"><span class="badge @confClass">@p.Confidence.ToString("P0")</span></td>
                        }
                        else
                        {
                            <td data-v="@p.Probability1.ToString(System.Globalization.CultureInfo.InvariantCulture)">@p.Probability1.ToString("P0")</td>
                            <td data-v="@p.ProbabilityX.ToString(System.Globalization.CultureInfo.InvariantCulture)">@p.ProbabilityX.ToString("P0")</td>
                            <td data-v="@p.Probability2.ToString(System.Globalization.CultureInfo.InvariantCulture)">@p.Probability2.ToString("P0")</td>
                            <td data-v="@p.Confidence.ToString(System.Globalization.CultureInfo.InvariantCulture)"><span class="badge @confClass">@p.Confidence.ToString("P0")</span></td>
                        }
                        <td style="max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="@p.Comment">@p.Comment</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
(function () {
    var table = document.getElementById('resultTable');
    if (!table || !table.tBodies.length) return;
    var body = table.tBodies[0];
    var heads = Array.prototype.slice.call(table.tHead.rows[0].cells);
    var rows = Array.prototype.slice.call(body.rows);
    rows.forEach(function (r, i) { r.dataset.i = i; });

    var bar = document.getElementById('sortBar');
    var select = document.getElementById('sortSelect');
    var dirBtn = document.getElementById('sortDir');
    var resetBtn = document.getElementById('sortReset');
    var state = { col: -1, asc: true };

    heads.forEach(function (th, i) {
        var opt = document.createElement('option');
        opt.value = i;
        opt.textContent = th.dataset.label || th.textContent;
        select.appendChild(opt);
        th.classList.add('sortable');
        th.setAttribute('tabindex', '0');
        th.setAttribute('role', 'button');
        th.addEventListener('click', function () { choose(i); });
        th.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); choose(i); }
        });
    });
    select.insertBefore(new Option('Ordre initial', -1), select.firstChild);
    select.value = -1;
    bar.hidden = false;

    function value(row, col) {
        var td = row.cells[col];
        var v = td.dataset.v !== undefined ? td.dataset.v : td.textContent.trim();
        return heads[col].dataset.type === 'num' ? parseFloat(v) : v;
    }

    function apply() {
        var col = state.col;
        var sorted = rows.slice();
        if (col >= 0) {
            var num = heads[col].dataset.type === 'num';
            sorted.sort(function (a, b) {
                var x = value(a, col), y = value(b, col), c;
                if (num) c = (isNaN(x) ? -Infinity : x) - (isNaN(y) ? -Infinity : y);
                else c = String(x).localeCompare(String(y), 'fr', { sensitivity: 'base', numeric: true });
                if (c === 0) c = a.dataset.i - b.dataset.i;
                return state.asc ? c : (c === 0 ? 0 : -c);
            });
        } else {
            sorted.sort(function (a, b) { return a.dataset.i - b.dataset.i; });
        }
        sorted.forEach(function (r) { body.appendChild(r); });

        heads.forEach(function (th, i) {
            th.removeAttribute('aria-sort');
            th.classList.remove('sorted-asc', 'sorted-desc');
            if (i === col) {
                th.setAttribute('aria-sort', state.asc ? 'ascending' : 'descending');
                th.classList.add(state.asc ? 'sorted-asc' : 'sorted-desc');
            }
        });
        select.value = col;
        dirBtn.textContent = state.asc ? '↑ Croissant' : '↓ Décroissant';
        dirBtn.disabled = col < 0;
    }

    function choose(col) {
        if (col === state.col) state.asc = !state.asc;
        else { state.col = col; state.asc = heads[col].dataset.type !== 'num'; }
        apply();
    }

    select.addEventListener('change', function () {
        state.col = parseInt(select.value, 10);
        state.asc = state.col < 0 || heads[state.col].dataset.type !== 'num';
        apply();
    });
    dirBtn.addEventListener('click', function () { if (state.col >= 0) { state.asc = !state.asc; apply(); } });
    resetBtn.addEventListener('click', function () { state.col = -1; state.asc = true; apply(); });
    apply();
})();
</script>
}
