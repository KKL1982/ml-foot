@model FootballPrediction.Web.Models.LoginViewModel
@{
    ViewData["Title"] = "Login";
    var env = Context.RequestServices.GetRequiredService<Microsoft.AspNetCore.Hosting.IWebHostEnvironment>();
}

<div class="page-title">Sign In</div>
<div class="page-subtitle">Access your Football AI dashboard</div>

<div style="max-width:420px;margin:32px auto">
    <div class="card">
        <div class="card-header">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M15 3h4a2 2 0 012 2v14a2 2 0 01-2 2h-4"/>
                <polyline points="10,17 15,12 10,7"/>
                <line x1="15" y1="12" x2="3" y2="12"/>
            </svg>
            Sign in to continue
        </div>
        <div asp-validation-summary="All" style="color:var(--red);font-size:12px;margin-bottom:16px"></div>

        <form asp-action="Login" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl" />

            <div class="form-group" style="margin-bottom:16px">
                <label asp-for="Email" class="form-label">📧 Email</label>
                <input asp-for="Email" class="form-control" placeholder="your@email.com" autofocus />
                <span asp-validation-for="Email" class="field-validation-error"></span>
            </div>

            <div class="form-group" style="margin-bottom:16px">
                <label asp-for="Password" class="form-label">🔒 Password</label>
                <div class="password-field">
                    <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" autocomplete="current-password" />
                    <button type="button" class="password-toggle" id="togglePassword"
                            aria-label="Afficher le mot de passe" aria-pressed="false" hidden>
                        <svg class="icon-show" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
                        </svg>
                        <svg class="icon-hide" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" hidden>
                            <path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19M14.12 14.12a3 3 0 11-4.24-4.24"/>
                            <line x1="1" y1="1" x2="23" y2="23"/>
                        </svg>
                    </button>
                </div>
                <span asp-validation-for="Password" class="field-validation-error"></span>
            </div>

            <div class="form-group" style="margin-bottom:20px;display:flex;align-items:center;gap:8px">
                <input asp-for="RememberMe" type="checkbox" style="accent-color:var(--blue)" />
                <label asp-for="RememberMe" style="font-size:13px;color:var(--tx2);cursor:pointer">Remember me for 7 days</label>
            </div>

            <button type="submit" class="btn btn-green btn-lg" style="width:100%">
                🔓 Sign In
            </button>
        </form>
    </div>

    @if (!env.IsProduction())
    {
        <p style="text-align:center;margin-top:16px;font-size:12px;color:var(--tx3)">
            💡 Dev hint — admin: <code style="color:var(--tx2)">admin@football-prediction.local</code> / <code style="color:var(--tx2)">Admin123!</code>
        </p>
    }
</div>

@section Scripts {
<script>
(function () {
    var input = document.getElementById('Password');
    var btn = document.getElementById('togglePassword');
    if (!input || !btn) return;
    btn.hidden = false;
    btn.addEventListener('click', function () {
        var show = input.type === 'password';
        input.type = show ? 'text' : 'password';
        btn.setAttribute('aria-pressed', show);
        btn.setAttribute('aria-label', show ? 'Masquer le mot de passe' : 'Afficher le mot de passe');
        btn.querySelector('.icon-show').hidden = show;
        btn.querySelector('.icon-hide').hidden = !show;
        input.focus();
    });
})();
</script>
}
